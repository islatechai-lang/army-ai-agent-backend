# ========================================================
# WHOP AGENT ARMY - ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================================

# 1. Whop Business & API Credentials
WHOP_API_KEY=your_whop_company_api_key_here
WHOP_BIZ_ID=biz_your_business_id
WHOP_DOCS_MCP_URL=https://docs.whop.com/mcp
WHOP_API_MCP_URL=https://mcp.whop.com/mcp

# 2. Unorouter AI LLM Configuration (Free Models Mesh)
UNOROUTER_API_KEY=your_unorouter_api_key_here
UNOROUTER_ENDPOINT=https://api.unorouter.com/v1/chat/completions

# 3. Supabase Cloud Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_publishable_or_anon_key

# 4. Runtime & Security Overrides
NODE_TLS_REJECT_UNAUTHORIZED=0
PYTHON_VERSION=3.11.0
